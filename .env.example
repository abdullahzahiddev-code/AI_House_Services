# Environment variables for AI Home Service Platform
# Copy this file to .env and fill in your values

SECRET_KEY=django-insecure-change-this-in-production-use-a-real-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default; switch to PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# OpenAI / LLM Configuration
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Use a different OpenAI-compatible API
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=gpt-4o-mini

# AI model settings
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1500

# Embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB vector store location
CHROMA_PERSIST_DIR=vector_store/chroma_db

# Media files
MEDIA_ROOT=media
